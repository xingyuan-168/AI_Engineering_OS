{
  "mcpServers": {
    "ai-engineering-os": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "call",
        "./scripts/launch_mcp.cmd"
      ],
      "cwd": ".",
      "env_vars": ["PATH", "USERPROFILE"],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 3600
    }
  }
}
